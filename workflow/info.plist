				<key>script</key>
				<string># No --title for Ghostty: a Ghostty-set title is locked and ignores every
# later title change, so claude could never rename the tab. --name lets
# claude own the title (and de-duplicates it against other live sessions).
if [ -d "/Applications/Ghostty.app" ]; then
    nohup /Applications/Ghostty.app/Contents/MacOS/ghostty --working-directory="$1" -e fish -lic "claude --name \"$(basename "$1")\"" &gt; /dev/null 2&gt;&amp;1 &amp;
else
    osascript -e "tell application \"Terminal\"
        activate
        do script \"cd '$1' &amp;&amp; claude --name '$(basename "$1")'\"
    end tell"
fi</string>
