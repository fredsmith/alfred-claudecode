#!/bin/bash
# Main launcher script for rofi-based project launcher
# Usage: claude-launcher [vs|cc|gh|fm|review]

set -e

# Determine the script directory
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Default to VS Code if no argument
ACTION="${1:-vs}"

# Function to get project selection from rofi
get_project_selection() {
    "$SCRIPT_DIR/list_projects.py" | rofi -dmenu -i -p "Select project:" -format "s" -no-custom
}

# Function to launch a terminal running a given script file. Uses the first
# detected terminal emulator (or $TERMINAL if set).
launch_terminal_with_script() {
    local script="$1"
    if [ -n "$TERMINAL" ]; then
        $TERMINAL -e bash "$script"
    elif command -v x-terminal-emulator &> /dev/null; then
        x-terminal-emulator -e bash "$script"
    elif command -v ghostty &> /dev/null; then
        ghostty -e bash "$script"
    elif command -v gnome-terminal &> /dev/null; then
        gnome-terminal -- bash "$script"
    elif command -v konsole &> /dev/null; then
        konsole -e bash "$script"
    elif command -v xfce4-terminal &> /dev/null; then
        xfce4-terminal -e "bash $script"
    elif command -v alacritty &> /dev/null; then
        alacritty -e bash "$script"
    elif command -v kitty &> /dev/null; then
        kitty bash "$script"
    elif command -v wezterm &> /dev/null; then
        wezterm start -- bash "$script"
    else
        notify-send "Error" "No terminal emulator found. Set TERMINAL environment variable."
        return 1
    fi
}

# "review" is special: it takes a PR URL (and optional prompt) instead of a
# project from the list. Handle it before the project picker runs.
if [ "$ACTION" = "review" ]; then
    if ! command -v gh &> /dev/null; then
        notify-send "Review" "GitHub CLI (gh) not found in PATH"
        exit 1
    fi
    if ! command -v claude &> /dev/null; then
        notify-send "Review" "Claude Code (claude) not found in PATH"
        exit 1
    fi

    # Collect any args after "review" as the initial query (URL + optional prompt)
    QUERY="${*:2}"
    if [ -z "$QUERY" ]; then
        QUERY=$(rofi -dmenu -p "PR URL [+ prompt]:" -lines 0 < /dev/null)
    fi
    if [ -z "$QUERY" ]; then
        exit 0
    fi

    # First whitespace-separated token is the URL; the rest is the prompt.
    URL="${QUERY%%[[:space:]]*}"
    if [ "$URL" = "$QUERY" ]; then
        PROMPT=""
    else
        PROMPT="${QUERY#*[[:space:]]}"
    fi

    if [[ "$URL" =~ github\.com/([^/]+)/([^/]+)/pull/([0-9]+) ]]; then
        OWNER="${BASH_REMATCH[1]}"
        REPO="${BASH_REMATCH[2]}"
        PR_NUMBER="${BASH_REMATCH[3]}"
    else
        notify-send "Review" "Not a recognizable GitHub PR URL: $URL"
        exit 1
    fi

    REPO_PATH="$HOME/src/github.com/$OWNER/$REPO"
    if [ ! -d "$REPO_PATH" ]; then
        notify-send "Review" "Repo not found at $REPO_PATH. Clone it first."
        exit 1
    fi

    GUIDELINES="You are reviewing the pull request $URL, which is checked out in this working directory. Your job is to review the code, not change it.

Rules:
- Do not edit, stage, or commit any files in this working directory.
- Deliver all feedback through the GitHub review interface (use \`gh\` for inline comments, review summaries, and suggested changes) rather than by modifying the working tree.
- Prefer concrete suggested-change blocks over prose when proposing edits.

Acknowledge these guidelines and wait for further instruction before starting the review."

    if [ -n "$PROMPT" ]; then
        GUIDELINES="$GUIDELINES

$PROMPT"
    fi

    # Write the in-terminal commands to a temp script so the prompt can be
    # safely shell-quoted. On error we keep the window open by exec'ing bash.
    TMP_SCRIPT=$(mktemp --suffix=.sh)
    {
        echo '#!/bin/bash'
        printf 'cd %q || { echo "ERROR: cd failed"; exec bash; }\n' "$REPO_PATH"
        printf 'echo "Fetching latest refs from origin (so PR-review diffs use a current base)..."\n'
        printf 'git fetch --prune origin\n'
        printf 'echo "Checking out PR #%s..."\n' "$PR_NUMBER"
        printf 'gh pr checkout %s || { echo "ERROR: gh pr checkout failed"; exec bash; }\n' "$PR_NUMBER"
        echo 'echo'
        printf 'claude %q\n' "$GUIDELINES"
        printf 'rm -f %q\n' "$TMP_SCRIPT"
    } > "$TMP_SCRIPT"
    chmod +x "$TMP_SCRIPT"

    launch_terminal_with_script "$TMP_SCRIPT"
    exit 0
fi

# Get selected project path
PROJECT_PATH=$(get_project_selection)

# Exit if no selection made
if [ -z "$PROJECT_PATH" ]; then
    exit 0
fi

# Handle the action based on the argument
case "$ACTION" in
    vs|vscode)
        # Launch VS Code
        if command -v code &> /dev/null; then
            code "$PROJECT_PATH"
        else
            notify-send "Error" "VS Code (code) not found in PATH"
            exit 1
        fi
        ;;
    cc|claude)
        # Launch Claude Code in terminal
        if command -v claude &> /dev/null; then
            # Detect terminal emulator
            if [ -n "$TERMINAL" ]; then
                $TERMINAL -e bash -c "cd '$PROJECT_PATH' && claude"
            elif command -v x-terminal-emulator &> /dev/null; then
                x-terminal-emulator -e bash -c "cd '$PROJECT_PATH' && claude"
            elif command -v gnome-terminal &> /dev/null; then
                gnome-terminal -- bash -c "cd '$PROJECT_PATH' && claude; exec bash"
            elif command -v konsole &> /dev/null; then
                konsole -e bash -c "cd '$PROJECT_PATH' && claude; exec bash"
            elif command -v xfce4-terminal &> /dev/null; then
                xfce4-terminal -e "bash -c 'cd \"$PROJECT_PATH\" && claude; exec bash'"
            elif command -v alacritty &> /dev/null; then
                alacritty -e bash -c "cd '$PROJECT_PATH' && claude; exec bash"
            elif command -v kitty &> /dev/null; then
                kitty bash -c "cd '$PROJECT_PATH' && claude; exec bash"
            elif command -v wezterm &> /dev/null; then
                wezterm start --cwd "$PROJECT_PATH" -- claude
            else
                notify-send "Error" "No terminal emulator found. Set TERMINAL environment variable."
                exit 1
            fi
        else
            notify-send "Error" "Claude Code (claude) not found in PATH"
            exit 1
        fi
        ;;
    gh|github)
        # Open GitHub repo in browser
        cd "$PROJECT_PATH" || exit 1
        URL=$(git remote get-url origin 2>/dev/null | sed 's/git@github.com:/https:\/\/github.com\//' | sed 's/\.git$//')

        if [ -n "$URL" ]; then
            if command -v xdg-open &> /dev/null; then
                xdg-open "$URL"
            elif command -v open &> /dev/null; then
                open "$URL"
            else
                notify-send "Error" "No browser opener found (xdg-open)"
                exit 1
            fi
        else
            notify-send "Error" "Not a git repository or no remote origin found"
            exit 1
        fi
        ;;
    fm|files)
        # Open in file manager
        if command -v xdg-open &> /dev/null; then
            xdg-open "$PROJECT_PATH"
        elif command -v nautilus &> /dev/null; then
            nautilus "$PROJECT_PATH"
        elif command -v dolphin &> /dev/null; then
            dolphin "$PROJECT_PATH"
        elif command -v thunar &> /dev/null; then
            thunar "$PROJECT_PATH"
        else
            notify-send "Error" "No file manager found"
            exit 1
        fi
        ;;
    *)
        echo "Usage: $0 [vs|cc|gh|fm|review]"
        echo "  vs                          Open in VS Code"
        echo "  cc                          Open in Claude Code (terminal)"
        echo "  gh                          Open GitHub repo in browser"
        echo "  fm                          Open in file manager"
        echo "  review <pr-url> [prompt]    Check out a GitHub PR locally and launch Claude Code primed with reviewer guidelines (optional prompt appended)"
        exit 1
        ;;
esac
